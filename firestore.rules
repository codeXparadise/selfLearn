rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Each authenticated user has full read/write access ONLY to their own data tree
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's enrolled courses and video completion progress
      match /courses/{courseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any nested subcollections under user (notes, timestamps, bookmarks)
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

